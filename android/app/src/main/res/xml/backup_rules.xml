<?xml version="1.0" encoding="utf-8"?>
<!--
  Generational Wealth Roadmap is offline-first and stores no user data
  off-device. Legacy backup config (Android 11 and below): nothing is
  eligible for backup.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
